<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('./partials/Head.ejs', { title: 'Início' }) %>
</head>
<body>
  <%- include('./partials/Header.ejs', { active: 'home' }) %>

  <main>
    <section class="hero">
      <div class="container">
        <div>
          <span class="eyebrow"><span class="dot"><i class="ph-bold ph-plus"></i></span> O guia digital de Matipó · MG</span>
          <h1>Tudo o que a cidade oferece, <span class="hl">num só lugar.</span></h1>
          <p class="hero-lead">Encontre comércios, farmácias de plantão, vagas de emprego e imóveis para alugar em Matipó — com horários, contatos e mapa.</p>

          <form class="hero-search" data-search-form role="search">
            <i class="ph-bold ph-magnifying-glass"></i>
            <label class="sr-only" for="hero-q">Buscar</label>
            <input id="hero-q" type="search" placeholder="O que você procura? Ex.: farmácia, padaria…" data-search-input autocomplete="off">
            <button class="btn btn-accent" type="submit"><i class="ph-bold ph-arrow-right"></i><span>Buscar</span></button>
          </form>
        </div>

        <div class="hero-stats">
          <a class="stat-card" href="/business/index">
            <span class="icon" style="background: rgba(255, 138, 31, .18); color: #ffa857"><i class="ph-fill ph-storefront"></i></span>
            <div><strong><%= allBusiness.length %></strong><span>comércios cadastrados</span></div>
          </a>
          <a class="stat-card" href="/jobs/index">
            <span class="icon" style="background: rgba(124, 77, 255, .2); color: #b39dff"><i class="ph-fill ph-briefcase"></i></span>
            <div><strong><%= allJobs.length %></strong><span>vagas de emprego</span></div>
          </a>
          <a class="stat-card" href="/housing/index">
            <span class="icon" style="background: rgba(14, 165, 160, .2); color: #5eead4"><i class="ph-fill ph-house-line"></i></span>
            <div><strong><%= allHousing.length %></strong><span>imóveis e hospedagens</span></div>
          </a>
        </div>
      </div>
    </section>

    <section class="categories">
      <div class="container">
        <div class="category-grid">
          <a class="category-tile c-business" href="/business/index">
            <span class="icon"><i class="ph-fill ph-storefront"></i></span>
            <div><h3>Comércios</h3><p>Lojas e serviços</p></div>
          </a>
          <a class="category-tile c-health" href="/health/index">
            <span class="icon"><i class="ph-fill ph-first-aid-kit"></i></span>
            <div><h3>Saúde</h3><p>Farmácias e clínicas</p></div>
          </a>
          <a class="category-tile c-housing" href="/housing/index">
            <span class="icon"><i class="ph-fill ph-house-line"></i></span>
            <div><h3>Moradia</h3><p>Aluguel e hospedagem</p></div>
          </a>
          <a class="category-tile c-jobs" href="/jobs/index">
            <span class="icon"><i class="ph-fill ph-briefcase"></i></span>
            <div><h3>Empregos</h3><p>Vagas na cidade</p></div>
          </a>
          <a class="category-tile c-leisure" href="/leisure/index">
            <span class="soon">Em breve</span>
            <span class="icon"><i class="ph-fill ph-tree-palm"></i></span>
            <div><h3>Lazer</h3><p>Passeios e eventos</p></div>
          </a>
          <a class="category-tile c-public" href="/developing/">
            <span class="soon">Em breve</span>
            <span class="icon"><i class="ph-fill ph-bank"></i></span>
            <div><h3>Utilidade Pública</h3><p>Órgãos e serviços</p></div>
          </a>
        </div>
      </div>
    </section>

    <div data-results>
      <%
        const sections = [
          {
            id: 'carousel-business', cat: 'business', kicker: 'Comércios', icon: 'ph-storefront',
            title: 'Principais comércios', sub: 'Onde comprar, comer e resolver a vida em Matipó.', more: '/business/index',
            cards: allBusiness.map(business => ({
              href: '/businessView/' + business._id, photo: business.businessPhoto, cat: 'business', icon: 'ph-storefront',
              chip: business.categoryName || 'Comércio', title: business.businessName, status: business.status, featured: business.featured,
              meta: [
                { icon: 'ph-map-pin', text: business.businessLocation },
                { icon: 'ph-phone', text: (business.businessContact && (business.businessContact.whatsApp || business.businessContact.tel)) || '' },
              ],
            })),
          },
          {
            id: 'carousel-job', cat: 'jobs', kicker: 'Empregos', icon: 'ph-briefcase',
            title: 'Vagas de emprego', sub: 'Oportunidades abertas agora em empresas locais.', more: '/jobs/index',
            cards: allJobs.map(job => ({
              href: '/jobsView/' + job._id, photo: job.jobPhoto, cat: 'jobs', icon: 'ph-briefcase',
              chip: job.categoryName || 'Vaga', title: job.jobName, status: job.status, featured: job.featured,
              meta: [
                { icon: 'ph-buildings', text: job.businessName },
                { icon: 'ph-map-pin', text: job.jobLocation },
              ],
            })),
          },
          {
            id: 'carousel-housing', cat: 'housing', kicker: 'Moradia', icon: 'ph-house-line',
            title: 'Imóveis e hospedagem', sub: 'Casas, apartamentos e quartos disponíveis.', more: '/housing/index',
            cards: allHousing.map(housing => ({
              href: '/housingView/' + housing._id, photo: housing.housingPhoto, cat: 'housing', icon: 'ph-house-line',
              chip: 'Moradia', title: housing.housingName, status: housing.status, featured: housing.featured,
              meta: [
                { icon: 'ph-map-pin', text: housing.housingLocation },
                { icon: 'ph-bed', text: housing.roomsQTD ? housing.roomsQTD + (housing.roomsQTD == 1 ? ' quarto' : ' quartos') : '' },
              ],
            })),
          },
        ];
      %>

      <% sections.forEach(section => { %>
        <section class="section reveal c-<%= section.cat %>" data-section>
          <div class="container">
            <div class="section-head">
              <div>
                <span class="section-kicker"><i class="ph-fill <%= section.icon %>"></i> <%= section.kicker %></span>
                <h2 class="section-title"><%= section.title %></h2>
                <p class="section-sub"><%= section.sub %></p>
              </div>
              <div class="section-actions">
                <a class="link-arrow" href="<%= section.more %>">Ver todos <i class="ph-bold ph-arrow-right"></i></a>
                <% if (section.cards.length > 1) { %>
                  <button class="icon-btn" type="button" data-prev="<%= section.id %>" aria-label="Anterior"><i class="ph-bold ph-caret-left"></i></button>
                  <button class="icon-btn" type="button" data-next="<%= section.id %>" aria-label="Próximo"><i class="ph-bold ph-caret-right"></i></button>
                <% } %>
              </div>
            </div>

            <% if (section.cards.length) { %>
              <div class="carousel" id="<%= section.id %>" data-carousel data-filterable>
                <% section.cards.forEach(card => { %>
                  <%- include('./partials/ListingCard.ejs', card) %>
                <% }) %>
              </div>
            <% } else { %>
              <div class="empty">
                <div class="icon"><i class="ph-bold <%= section.icon %>"></i></div>
                <strong>Nenhum cadastro ainda</strong>
                <span>Novidades aparecerão aqui em breve.</span>
              </div>
            <% } %>
          </div>
        </section>
      <% }) %>
    </div>

    <section class="section reveal">
      <div class="container">
        <div class="cta">
          <div>
            <h2>Tem um negócio em Matipó?</h2>
            <p>Cadastre seu comércio, vaga ou imóvel gratuitamente e seja encontrado por toda a cidade.</p>
          </div>
          <div class="actions">
            <a class="btn btn-accent" href="/contato?tipo=cadastro"><i class="ph-bold ph-storefront"></i> Cadastrar meu negócio</a>
            <a class="btn btn-light" href="https://www.instagram.com/matipomais" target="_blank" rel="noopener"><i class="ph-bold ph-instagram-logo"></i> @matipomais</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('./partials/Footer.ejs') %>
  <%- include('./partials/Scripts.ejs') %>
</body>
</html>
