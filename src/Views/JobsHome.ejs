<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('./partials/Head.ejs', { title: 'Empregos' }) %>
</head>
<body>
  <%- include('./partials/Header.ejs', { active: 'jobs' }) %>
  <main>
    <%
      const cards = allJobs.map(job => ({
        href: '/jobsView/' + job._id,
        photo: job.jobPhoto,
        cat: 'jobs',
        icon: 'ph-briefcase',
        chip: job.categoryName || 'Vaga',
        title: job.jobName,
        status: job.status, featured: job.featured,
        meta: [
          { icon: 'ph-buildings', text: job.businessName },
          { icon: 'ph-map-pin', text: job.jobLocation },
        ],
      }));
    %>
    <%- include('./partials/ListingPage.ejs', {
      cat: 'jobs', icon: 'ph-briefcase', heading: 'Oportunidades de Emprego',
      subtitle: 'Vagas abertas em empresas e comércios de Matipó. Encontre seu próximo trabalho.',
      filters: { open: 'Vagas abertas', closed: 'Encerradas' },
      cards,
    }) %>
  </main>
  <%- include('./partials/Footer.ejs') %>
  <%- include('./partials/Scripts.ejs') %>
</body>
</html>
