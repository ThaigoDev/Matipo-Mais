<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('./partials/Head.ejs', { title: job.jobName }) %>
</head>
<body>
  <%- include('./partials/Header.ejs', { active: 'jobs' }) %>
  <main>
    <% const contact = job.jobContact || {}; %>
    <%- include('./partials/DetailPage.ejs', {
      cat: 'jobs', icon: 'ph-briefcase',
      back: '/jobs/index', backLabel: 'Empregos',
      kicker: job.categoryName || 'Vaga de emprego',
      id: job._id, featured: job.featured,
      name: job.jobName,
      status: job.status,
      location: job.jobLocation,
      photo: job.jobPhoto,
      description: job.jobDescription,
      map: job.jobMapHTML,
      published: job.datePublish,
      publisher: job.publisher,
      contacts: { whatsApp: contact.whatsApp, phone: contact.phone, email: contact.email },
      facts: [
        { icon: 'ph-buildings', label: 'Empresa', value: job.businessName },
        { icon: 'ph-map-pin', label: 'Endereço', value: job.jobLocation },
        { icon: 'ph-clock', label: 'Horário de trabalho', value: job.openingTime && job.closingTime ? job.openingTime + ' às ' + job.closingTime : '' },
        { icon: 'ph-calendar-blank', label: 'Dias de trabalho', value: (job.operatingDays || []).length ? job.operatingDays : '' },
      ],
    }) %>
  </main>
  <%- include('./partials/Footer.ejs') %>
  <%- include('./partials/Scripts.ejs') %>
</body>
</html>
