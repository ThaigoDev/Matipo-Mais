<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('./partials/Head.ejs', { title: 'Entrar' }) %>
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>
  <main class="auth">
    <section class="auth-art">
      <a class="auth-brand" href="/"><img src="/utilites/logo2.png" alt="Matipó +"></a>
      <div class="auth-copy">
        <span class="eyebrow"><span class="dot"><i class="ph-bold ph-lock-simple"></i></span> Área administrativa</span>
        <h1>Gerencie o conteúdo do <span class="hl">Matipó +</span></h1>
        <p>Cadastre e atualize comércios, serviços de saúde, imóveis e vagas de emprego da cidade.</p>
      </div>
      <a class="back" href="/"><i class="ph-bold ph-arrow-left"></i> Voltar para o site</a>
    </section>

    <section class="auth-form">
      <div class="auth-card">
        <h2>Entrar</h2>
        <p class="lead">Use sua conta de administrador para continuar.</p>

        <% erros.forEach(erro => { %>
          <div class="alert alert-error"><i class="ph-bold ph-warning-circle"></i> <%= erro %></div>
        <% }) %>
        <% success.forEach(scss => { %>
          <div class="alert alert-success"><i class="ph-bold ph-check-circle"></i> <%= scss %></div>
        <% }) %>

        <form action="/admin/auth/" method="post">
          <label class="field">
            <span>E-mail</span>
            <div class="control">
              <i class="ph-bold ph-envelope-simple"></i>
              <input type="email" name="email" placeholder="voce@exemplo.com" autocomplete="email" required>
            </div>
          </label>
          <label class="field">
            <span>Senha</span>
            <div class="control">
              <i class="ph-bold ph-lock-simple"></i>
              <input type="password" name="password" id="password" placeholder="••••••••" autocomplete="current-password" required>
              <button type="button" class="reveal-pass" id="toggle-password" aria-label="Mostrar senha"><i class="ph-bold ph-eye"></i></button>
            </div>
          </label>
          <button class="btn btn-primary btn-block" type="submit">Entrar <i class="ph-bold ph-arrow-right"></i></button>
        </form>
      </div>
    </section>
  </main>

  <script>
    document.getElementById("toggle-password").addEventListener("click", function () {
      const input = document.getElementById("password");
      const hidden = input.type === "password";
      input.type = hidden ? "text" : "password";
      this.setAttribute("aria-label", hidden ? "Ocultar senha" : "Mostrar senha");
      this.innerHTML = hidden ? '<i class="ph-bold ph-eye-slash"></i>' : '<i class="ph-bold ph-eye"></i>';
    });
  </script>
</body>
</html>
