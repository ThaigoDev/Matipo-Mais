<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('./partials/Head.ejs', { title: 'Moradia' }) %>
</head>
<body>
  <%- include('./partials/Header.ejs', { active: 'housing' }) %>
  <main>
    <%
      const cards = allHousing.map(housing => ({
        href: '/housingView/' + housing._id,
        photo: housing.housingPhoto,
        cat: 'housing',
        icon: 'ph-house-line',
        chip: 'Moradia',
        title: housing.housingName,
        status: housing.status, featured: housing.featured,
        meta: [
          { icon: 'ph-map-pin', text: housing.housingLocation },
          { icon: 'ph-bed', text: housing.roomsQTD ? housing.roomsQTD + (housing.roomsQTD == 1 ? ' quarto' : ' quartos') + (housing.bathroomsQTD ? ' · ' + housing.bathroomsQTD + (housing.bathroomsQTD == 1 ? ' banheiro' : ' banheiros') : '') : '' },
        ],
      }));
    %>
    <%- include('./partials/ListingPage.ejs', {
      cat: 'housing', icon: 'ph-house-line', heading: 'Moradia e Hospedagem',
      subtitle: 'Casas, apartamentos e quartos para alugar, além de opções de hospedagem.',
      filters: { open: 'Disponíveis', closed: 'Indisponíveis' },
      cards,
    }) %>
  </main>
  <%- include('./partials/Footer.ejs') %>
  <%- include('./partials/Scripts.ejs') %>
</body>
</html>
