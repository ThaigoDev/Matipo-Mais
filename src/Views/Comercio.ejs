<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('./partials/Head.ejs', { title: 'Comércios' }) %>
</head>
<body>
  <%- include('./partials/Header.ejs', { active: 'business' }) %>
  <main>
    <%
      const cards = allBusiness.map(business => ({
        href: '/businessView/' + business._id,
        photo: business.businessPhoto,
        cat: 'business',
        icon: 'ph-storefront',
        chip: business.categoryName || 'Comércio',
        title: business.businessName,
        status: business.status, featured: business.featured,
        meta: [
          { icon: 'ph-map-pin', text: business.businessLocation },
          { icon: 'ph-clock', text: business.openingTime && business.closingTime ? business.openingTime + ' às ' + business.closingTime : '' },
        ],
      }));
    %>
    <%- include('./partials/ListingPage.ejs', {
      cat: 'business', icon: 'ph-storefront', heading: 'Comércios',
      subtitle: 'Lojas, mercados, restaurantes e serviços de Matipó — com horário e contato.',
      filters: { open: 'Abertos agora', closed: 'Fechados' },
      cards,
    }) %>
  </main>
  <%- include('./partials/Footer.ejs') %>
  <%- include('./partials/Scripts.ejs') %>
</body>
</html>
