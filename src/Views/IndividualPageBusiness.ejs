<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('./partials/Head.ejs', { title: business.businessName }) %>
</head>
<body>
  <%- include('./partials/Header.ejs', { active: 'business' }) %>
  <main>
    <% const contact = business.businessContact || {}; %>
    <%- include('./partials/DetailPage.ejs', {
      cat: 'business', icon: 'ph-storefront',
      back: '/business/index', backLabel: 'Comércios',
      kicker: business.categoryName || 'Comércio',
      id: business._id, featured: business.featured,
      name: business.businessName,
      status: business.status,
      location: business.businessLocation,
      photo: business.businessPhoto,
      description: business.businessDescription,
      map: business.businessMapHTML,
      published: business.datePublish,
      publisher: business.publisher,
      contacts: { whatsApp: contact.whatsApp, phone: contact.tel, email: contact.email },
      facts: [
        { icon: 'ph-map-pin', label: 'Endereço', value: business.businessLocation },
        { icon: 'ph-clock', label: 'Horário', value: business.openingTime && business.closingTime ? business.openingTime + ' às ' + business.closingTime : '' },
        { icon: 'ph-calendar-blank', label: 'Dias de funcionamento', value: (business.operatingDays || []).length ? business.operatingDays : '' },
      ],
    }) %>
  </main>
  <%- include('./partials/Footer.ejs') %>
  <%- include('./partials/Scripts.ejs') %>
</body>
</html>
