<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('./partials/Head.ejs', { title: health.healthName }) %>
</head>
<body>
  <%- include('./partials/Header.ejs', { active: 'health' }) %>
  <main>
    <% const contact = health.healthContactInfos || {}; %>
    <%- include('./partials/DetailPage.ejs', {
      cat: 'health', icon: 'ph-first-aid-kit',
      back: '/health/index', backLabel: 'Saúde',
      kicker: health.categoryName || 'Saúde',
      id: health._id, featured: health.featured,
      name: health.healthName,
      status: health.status,
      location: health.healthLocation,
      photo: health.healthPhoto,
      description: health.healthDescription,
      map: health.healthHTMLMap,
      published: health.datePublish,
      publisher: health.publisher,
      contacts: { whatsApp: contact.whatsApp, phone: contact.phone, email: contact.email },
      facts: [
        { icon: 'ph-map-pin', label: 'Endereço', value: health.healthLocation },
        { icon: 'ph-clock', label: 'Horário', value: health.openingTime && health.closingTime ? health.openingTime + ' às ' + health.closingTime : '' },
        { icon: 'ph-calendar-blank', label: 'Dias de funcionamento', value: (health.operatingDays || []).length ? health.operatingDays : '' },
        { icon: 'ph-first-aid', label: 'Dias de plantão', value: (health.daysOnDuty || []).length ? health.daysOnDuty : '' },
      ],
    }) %>
  </main>
  <%- include('./partials/Footer.ejs') %>
  <%- include('./partials/Scripts.ejs') %>
</body>
</html>
