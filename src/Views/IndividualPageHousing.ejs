<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('./partials/Head.ejs', { title: housing.housingName }) %>
</head>
<body>
  <%- include('./partials/Header.ejs', { active: 'housing' }) %>
  <main>
    <% const contact = housing.housingContactInfos || {}; %>
    <%- include('./partials/DetailPage.ejs', {
      cat: 'housing', icon: 'ph-house-line',
      back: '/housing/index', backLabel: 'Moradia',
      kicker: 'Moradia e Hospedagem',
      id: housing._id, featured: housing.featured,
      name: housing.housingName,
      status: housing.status,
      location: housing.housingLocation,
      photo: housing.housingPhoto,
      description: housing.housingDescription,
      map: housing.housingHTMLMap,
      published: housing.datePublish,
      publisher: housing.publisher,
      contacts: { whatsApp: contact.whatsApp, phone: contact.phone, email: contact.email },
      facts: [
        { icon: 'ph-map-pin', label: 'Endereço', value: housing.housingLocation },
        { icon: 'ph-bed', label: 'Quartos', value: housing.roomsQTD != null ? String(housing.roomsQTD) : '' },
        { icon: 'ph-bathtub', label: 'Banheiros', value: housing.bathroomsQTD != null ? String(housing.bathroomsQTD) : '' },
      ],
    }) %>
  </main>
  <%- include('./partials/Footer.ejs') %>
  <%- include('./partials/Scripts.ejs') %>
</body>
</html>
